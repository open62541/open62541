#ifndef UA_POSIX_H_
#define UA_POSIX_H_

/**
 * POSIX Feature Flags
 * -------------------
 * These feature flags have to be set before including the first POSIX
 * header. */

/* Special note for FreeBSD: Defining _XOPEN_SOURCE will hide lots of socket
 * definitions as they are not defined by POSIX. Defining _BSD_SOURCE will not
 * help as the symbols undergo a consistency check and get adjusted in the
 * headers. */
#ifdef UA_ARCHITECTURE_POSIX
# if !defined(_XOPEN_SOURCE) && !defined(__FreeBSD__)
#  define _XOPEN_SOURCE 600
# endif
# ifndef _DEFAULT_SOURCE
#  define _DEFAULT_SOURCE
# endif

/* On older systems we need to define _BSD_SOURCE.
 * _DEFAULT_SOURCE is an alias for that. */
# ifndef _BSD_SOURCE
#  define _BSD_SOURCE
# endif

/* Define _GNU_SOURCE to get functions like poll. Comment this out to
 * only use standard POSIX definitions. */
# ifndef _GNU_SOURCE
#  define _GNU_SOURCE
# endif

# define UA_HAS_GETIFADDR 1
#endif /* UA_ARCHITECTURE_POSIX */

/* Defining _QNX_SOURCE will ensure proper qnx types and other features are
 * available. */
#if defined(__QNX__)
# define _QNX_SOURCE 1
#endif

/* Return a zero UTC offset and omit C library timezone conversion. */
#cmakedefine UA_ARCH_LOCAL_TIME_IS_UTC

#endif /* UA_POSIX_H_ */
